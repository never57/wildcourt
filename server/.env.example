# 复制为 .env 并填写（docker compose 读取）
# cp .env.example .env  &&  vim .env

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_APP_PASSWORD=change_me_app

# ---- 管理后台 ----
# JWT 签名密钥（必改！Linux 可用：openssl rand -hex 32 生成强随机值）
ADMIN_JWT_SECRET=please_set_a_long_random_secret
# 首次启动自动创建的管理员密码（登录成功后请到后台修改）
ADMIN_DEFAULT_PASSWORD=please_change_me
# 管理员用户名（可选，默认 admin）
ADMIN_DEFAULT_USERNAME=admin
